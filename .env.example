# All of these are OPTIONAL. Krushi works out of the box with zero keys:
#   - weather comes from Open-Meteo (free, keyless)
#   - the crop model trains on the bundled real dataset
#   - market prices for potato/tomato/wheat (ML-predicted) and onion/gram/
#     cucumber/brinjal/cluster beans/bottle gourd/amaranthus/carrot/snake
#     gourd/lemon (real observed median, from live Agmarknet records) all
#     work with zero keys — no simulation, ever
#
# Add keys below only if you want more crops covered live, or another
# weather provider.

# Alternative weather provider (openweathermap.org). Leave blank to use
# Open-Meteo (the default, free, no key needed).
OPENWEATHER_API_KEY=

# Free key from https://data.gov.in/ — enables real Indian mandi market
# prices instead of the simulated fallback.
MARKET_API_KEY=

# Enables the "Ask Krushi" chatbot (real Google Gemini API call). Get a
# free key at https://aistudio.google.com/apikey (no credit card needed).
# The free tier has generous per-minute/per-day limits, not a literal
# unlimited quota — if you hit them the chat page will say so plainly.
# Leave blank and the chat page will tell the user honestly that it isn't
# configured, instead of faking a reply.
GEMINI_API_KEY=
CHAT_MODEL=gemini-2.5-flash

# Enables real password-reset emails via SMTP. Without these, "forgot
# password" still works but returns the reset token directly in the
# response instead of emailing it (clearly labeled as a dev-mode fallback).
#
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your
# Gmail address, SMTP_PASSWORD=a 16-character App Password (NOT your
# normal Gmail password — generate one at https://myaccount.google.com/apppasswords,
# requires 2-Step Verification to be turned on first). SMTP_FROM can be
# left blank to default to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

SECRET_KEY=change-this-to-a-random-string
DEBUG=True
